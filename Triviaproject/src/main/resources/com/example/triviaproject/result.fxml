<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="684.0" style="-fx-background-color: grey;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.triviaproject.Result">
    <children>
        <Label layoutX="284.0" layoutY="47.0" prefHeight="38.0" prefWidth="167.0" text="Your result :" textFill="WHITE">
            <font>
                <Font name="Rockwell" size="27.0" />
            </font>
        </Label>
        <Label fx:id="remark" layoutX="292.0" layoutY="95.0" prefHeight="70.0" prefWidth="179.0" text="Very good work!" textFill="#00ff11" wrapText="true">
            <font>
                <Font name="Rockwell" size="16.0" />
            </font>
        </Label>
        <Label fx:id="marks" layoutX="49.0" layoutY="184.0" style="-fx-background-color: skyblue;" text="9/10" textFill="#1f3eff">
            <font>
                <Font name="Open Sans Extrabold" size="30.0" />
            </font>
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
            </padding>
        </Label>
        <Label fx:id="markstext" layoutX="55.0" layoutY="319.0" text="9 Your Score " textFill="#1f3eff">
            <font>
                <Font name="Open Sans Semibold" size="17.0" />
            </font>
        </Label>
        <ProgressIndicator fx:id="correct_progress" layoutX="277.0" layoutY="172.0" minHeight="130.0" minWidth="130.0" progress="0.9" style="-fx-background-color: lightgreen; -fx-progress-color: green; -fx-font-weight: 900; -fx-font-size: 18px; -fx-box-border: green;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </ProgressIndicator>
        <ProgressIndicator fx:id="wrong_progress" layoutX="492.0" layoutY="172.0" minHeight="130.0" minWidth="130.0" progress="0.1" style="-fx-background-color: FFCDD2; -fx-progress-color: red; -fx-font-weight: 900; -fx-font-size: 18px;  -fx-box-border: red;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </ProgressIndicator>
        <Label fx:id="correcttext" layoutX="305.0" layoutY="318.0" text="Correct  : 9" textFill="GREEN">
            <font>
                <Font name="Open Sans Semibold" size="17.0" />
            </font>
        </Label>
        <Label fx:id="wrongtext" layoutX="519.0" layoutY="317.0" text="Incorrect : 1" textFill="RED">
            <font>
                <Font name="Open Sans Semibold" size="17.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
